# F180 Hub — env vars (optional; takes precedence over config.json values)
# Copy to .env and fill in — or export in your shell profile.

# SMTP provider secret (preferred over email.smtp_pass in config.json)
HUB_SMTP_PASS=

# Resend provider secret (preferred over email.resend_api_key in config.json)
HUB_RESEND_API_KEY=

# Anthropic (used by BA Agent subprocess calls)
# ANTHROPIC_API_KEY=
